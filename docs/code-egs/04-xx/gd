# generate ".d" file for all ".c" file and stored in "d"
include common-mf

.PHONY: gdf clean pr

gdf: $(OD)

%.d: %.c
	@set -e; rm -f $@;\
	$(CC) -MM $(CPPFLAGS) $< > $@.$$$$;\
	cat $@.$$$$;echo $*;\
	sed 's,\($*\)\.o[ :]*,\1.o $@ : ,g' < $@.$$$$ > $@; \
	rm -f $@.$$$$

clean:
	-find . -name "*.d"  | xargs rm -f
	-find . -name "*.d.*"  | xargs rm -f

# use it to test the value of variable
pr:
	-@echo DIRS=$(DIRS)
	-@echo SRC=$(SRC)
	-@echo OD=$(OD)


