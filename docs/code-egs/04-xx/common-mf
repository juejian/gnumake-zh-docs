# define all common variable in makefile,
# other makefile files must include it at their start
CC = gcc
CFLAGS = -std=c17 -finput-charset=utf-8 -fexec-charset=gbk -g -m64

SRC_PATH = .
DF_DIRS = ./d
DIRS = $(shell find $(SRC_PATH) -type d)

# *.c in root dir and *.c in all subdir of workspace
SRC += $(foreach dir, $(DIRS), $(wildcard $(dir)/*.c))
OD = $(patsubst %.c,%.d, $(SRC))
OBJ = bin/
